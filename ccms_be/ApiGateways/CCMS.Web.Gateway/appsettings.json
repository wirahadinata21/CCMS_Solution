{
  "ReverseProxy": {
    "Routes": {
      "billing-route": {
        "ClusterId": "billing-cluster",
        "Match": { "Path": "/api/v1/billing/{**remainder}" }
      }
    },
    "Clusters": {
      "billing-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://localhost:5001" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
